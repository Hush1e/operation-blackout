{
  "name": "operation-blackout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && esbuild src/main.tsx --bundle --outfile=docs/game.js --servedir=docs --serve=127.0.0.1:3000 --watch",
    "check": "tsc --noEmit",
    "test": "esbuild src/App.tsx --bundle --platform=node --format=esm --packages=external --outfile=game-test.mjs && node test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.2"
  }
}
